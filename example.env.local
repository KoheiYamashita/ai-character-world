# ===================
# LLM設定（必須）
# ===================
# 対応プロバイダー:
#   - anthropic/claude-sonnet-4
#   - openai/gpt-4o-mini
#   - openai/chat/<model> (OpenAI互換API)
#   - google/gemini-2.0 or gemini/<model>
#   - openrouter/<provider>/<model>
LLM_MODEL=openai/chat/gpt-4o-mini
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=http://localhost:5001  # OpenAI互換APIなど、カスタムエンドポイント使用時

# ===================
# デバッグ・開発設定
# ===================
# EDITOR_MODE=true      # エディタモード（シミュレーション無効化）
# DEBUG_MODE=true       # デバッグログ有効化

# ===================
# エラー通知
# ===================
# ERROR_WEBHOOK_URL=https://example.com/webhook  # エラー時にPOSTするWebhook URL

# ===================
# Discord Gateway（チャット機能使用時）
# ===================
# DISCORD_BOT_TOKEN=your-discord-bot-token
# NEXT_SERVER_URL=http://localhost:3000
# GATEWAY_SECRET=your-gateway-secret
# GATEWAY_PORT=3001

# ===================
# チャットシステム設定
# ===================
# CHAT_PROVIDERS=discord                           # 有効なプロバイダー（カンマ区切り）
# CHAT_DISCORD_GATEWAY_URL=http://localhost:3001   # Discord Gateway URL
# CHAT_DISCORD_GATEWAY_SECRET=your-gateway-secret  # Gateway認証シークレット
# CHAT_DISCORD_DEFAULT_CHARACTERS=kohei,yuki       # デフォルトキャラクター（カンマ区切り）
# CHAT_DISCORD_CHANNELS={"channel-id":"kohei"}     # チャンネル→キャラクターマッピング（JSON）
